{
  "info": {
    "name": "BrewLite — 03A — Hai tài khoản tranh ly cuối: chuẩn bị",
    "description": "Chỉ chạy trên DB test/local. Tạo nguyên liệu và món test riêng đủ 1 ly M, hai CUSTOMER, hai Order PENDING bằng request song song và hai URL VNPay. Không thay kho/menu của sản phẩm có sẵn. Sau run, mở lastPaymentUrlA và lastPaymentUrlB ở hai tab, hoàn tất cả hai trên VNPay Sandbox trước hạn 15 phút. Không có callback giả.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Khởi tạo bài test và đăng nhập quản lý",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "if(!pm.environment.get('adminEmail') || !pm.environment.get('adminPassword'))throw new Error('Điền adminEmail/adminPassword trong environment trước.');",
              "const run=Date.now()+'-'+pm.variables.replaceIn('{{$randomUUID}}');",
              "pm.environment.set('lastRunId',run);",
              "pm.environment.set('lastBuyerAEmail','last-a-'+run+'@example.test');",
              "pm.environment.set('lastBuyerBEmail','last-b-'+run+'@example.test');",
              "['lastAdminToken','lastIngredientId','lastProductId','lastTokenA','lastTokenB','lastUserA','lastUserB','lastOrderA','lastOrderB','lastPaymentUrlA','lastPaymentUrlB','lastResultA','lastResultB'].forEach(function(key){pm.environment.unset(key);});",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 201', function(){pm.response.to.have.status(201);});",
              "const data=pm.response.json();",
              "pm.test('Có quyền tạo sản phẩm và kho',function(){pm.expect(data.user.role).to.be.oneOf(['ADMIN','MANAGER']);pm.expect(data.accessToken).to.be.a('string').and.not.empty;});",
              "if(pm.response.code===201)pm.environment.set('lastAdminToken',data.accessToken);",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Tạo nguyên liệu test riêng, chỉ đủ 1 ly",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/ingredients",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{lastAdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"LAST-CUP-{{lastRunId}}\",\n  \"unit\": \"ly\",\n  \"quantity\": 1,\n  \"lowStockThreshold\": 0,\n  \"costPrice\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 201', function(){pm.response.to.have.status(201);});",
              "const data=pm.response.json();",
              "pm.test('Tồn kho đúng 1 đơn vị',function(){pm.expect(data.quantity).to.equal(1);});",
              "if(pm.response.code===201)pm.environment.set('lastIngredientId',data.id);",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Tạo món test riêng",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{lastAdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"LAST-CUP-{{lastRunId}}\",\n  \"category\": \"Postman Test\",\n  \"price\": 10000,\n  \"description\": \"Dedicated last-item concurrency fixture\",\n  \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 201', function(){pm.response.to.have.status(201);});",
              "const data=pm.response.json();",
              "pm.test('Món test giá 10000, đang bán',function(){pm.expect(data.price).to.equal(10000);pm.expect(data.active).to.equal(true);});",
              "if(pm.response.code===201)pm.environment.set('lastProductId',data.id);",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Mỗi ly size M dùng đúng 1 đơn vị test",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/admin/recipes/product/{{lastProductId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{lastAdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"ingredientId\": \"{{lastIngredientId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 200', function(){pm.response.to.have.status(200);});",
              "const data=pm.response.json();",
              "pm.test('Công thức chỉ dùng nguyên liệu test',function(){pm.expect(data.items).to.have.lengthOf(1);pm.expect(data.items[0].ingredientId).to.equal(pm.environment.get('lastIngredientId'));pm.expect(data.items[0].quantity).to.equal(1);});",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
    {
