              "pm.test('HTTP 201', function(){pm.response.to.have.status(201);});",
              "const data=pm.response.json();",
              "pm.test('Có URL VNPay cho tài khoản A',function(){pm.expect(data.orderId).to.equal(pm.environment.get('lastOrderA'));pm.expect(data.paymentUrl.startsWith('https://sandbox.vnpayment.vn/')).to.equal(true);});",
              "if(pm.response.code===201)pm.environment.set('lastPaymentUrlA',data.paymentUrl);",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
