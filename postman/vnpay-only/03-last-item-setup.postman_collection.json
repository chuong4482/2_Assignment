      ]
    },
    {
      "name": "06A — Tạo tài khoản khách A",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{lastBuyerAEmail}}\",\n  \"password\": \"{{buyerAPassword}}\",\n  \"fullName\": \"Last Cup Customer A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test('HTTP 201', function(){pm.response.to.have.status(201);});",
              "const data=pm.response.json();",
              "pm.test('Tài khoản A là CUSTOMER',function(){pm.expect(data.user.role).to.equal('CUSTOMER');});",
              "if(pm.response.code===201){pm.environment.set('lastTokenA',data.accessToken);pm.environment.set('lastUserA',data.user.id);}",
              "if(pm.response.code>=400){pm.execution.setNextRequest(null);}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "06B — Tạo tài khoản khách B",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{lastBuyerBEmail}}\",\n  \"password\": \"{{buyerBPassword}}\",\n  \"fullName\": \"Last Cup Customer B\"\n}",
